{
  "name": "FreightFlow | Review Decision",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "freight/review",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "http://localhost:5173"
        }
      },
      "id": "r1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "ff-freight-review"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.item.json.body || {};\nconst errors = [];\nif (typeof b.record_id !== 'string' || !b.record_id.trim()) errors.push('record_id is required');\nif (!['approved', 'rejected'].includes(b.decision)) errors.push(\"decision must be 'approved' or 'rejected'\");\nif (b.corrections !== undefined && (typeof b.corrections !== 'object' || b.corrections === null || Array.isArray(b.corrections))) errors.push('corrections must be an object');\nif (b.decision === 'rejected' && !(typeof b.review_note === 'string' && b.review_note.trim())) errors.push('review_note is required when rejecting');\n// NOTE: reviewer identity/session is not enforced in the MVP; add auth before real use.\nreturn { json: { valid: errors.length === 0, errors, payload: {\n  record_id: b.record_id, job_id: b.job_id || null, decision: b.decision,\n  corrections: b.corrections || {}, review_note: b.review_note || null } } };"
      },
      "id": "r2",
      "name": "Validate Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "r3",
      "name": "Input Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_BASE_URL }}/internal/reviews",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}"
      },
      "id": "r4",
      "name": "Save Review Decision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      },
      "id": "r5",
      "name": "Respond with Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        -80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { accepted: false, errors: $json.errors } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "r6",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        160
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Decision": {
      "main": [
        [
          {
            "node": "Input Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Input Valid?": {
      "main": [
        [
          {
            "node": "Save Review Decision",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 400",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Review Decision": {
      "main": [
        [
          {
            "node": "Respond with Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "id": "freightflowreview01"
}
